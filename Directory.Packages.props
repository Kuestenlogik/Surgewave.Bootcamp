<Project>
  <!-- Central Package Version Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Surgewave Core (from local or CI NuGet feed) -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Plugins" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Client" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Core" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Runtime" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Broker" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Streams" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Compatibility.Confluent.Kafka" Version="0.3.1" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Testcontainers" Version="4.10.0" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Web -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <!-- Schema Registry -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Client.SchemaRegistry" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Schema.Registry" Version="0.3.1" />
    <!-- Reactive -->
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    <!-- Surgewave.AI packages -->
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Agents" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Rag" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Retrieval" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Documents" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Prompts" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Evaluation" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Multimodal" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Guardrails" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Nodes" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.MCP" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.A2A" Version="0.1.0" />
    <!-- Key connector packages -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Connector.VectorStore" Version="0.1.4" />
  </ItemGroup>
</Project>
