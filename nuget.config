<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- nuget.org only, deliberately. The lessons must restore for anyone who clones
         this repository, and a GitHub Packages source needs an org token nobody
         outside Kuestenlogik has: mapping Kuestenlogik.Surgewave.* there made every
         lesson unrestorable without one, CI included. Every package a lesson uses is
         published on nuget.org, so pre-release feeds are out of scope here - a lesson
         referencing a version that is not public yet is a bug in the lesson. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
